# Application Settings
ENVIRONMENT=development
PROJECT_NAME="HookPulse"
DEBUG=True
API_V1_STR=/api/v1

# Security
SECRET_KEY=supersecretkey-hookpulse-change-in-production-32bytes
DEFAULT_ENDPOINT_SLUG=ep_taxguard_prod
DEFAULT_SIGNING_SECRET=whsec_taxguard_secure_token_secret_123

# Database (PostgreSQL 16)
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=hookpulse
POSTGRES_PASSWORD=hookpulse_secret
POSTGRES_DB=hookpulse_db
DATABASE_URL=postgresql+asyncpg://hookpulse:hookpulse_secret@postgres:5432/hookpulse_db

# Redis 7
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
